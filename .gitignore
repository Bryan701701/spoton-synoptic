# Ignore everything by default
*

# Allow these files
!.gitignore
!README.md
!shipping_forecast_latest.json

# But keep the synoptic publish folder
!synoptic/
!synoptic/*.json

# Images are published directly by TFE and archived on the storage box.
# Keeping them out of Git prevents a new multi-megabyte blob every run.
*.png

# Keep the tools for atomic publish
!tools/
!tools/*.sh
!tools/*.py

# --- NEW: keep warehouse artifacts ---
!warehouse/
!warehouse/**/
!warehouse/**/*.parquet
!warehouse/**/*.csv
!warehouse/**/*.json
!warehouse/**/*.md

# Generated Netlify distribution
synoptic/dist/
